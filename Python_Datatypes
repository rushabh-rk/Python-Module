      "source": [
        "from datetime import datetime\n",
        "\n",
        "# 1. String variables\n",
        "student_name = \"Rushabh\"\n",
        "course_name = \"Python Programming\"\n",
        "city = \"Amravati\"\n",
        "\n",
        "# 2. Number variables\n",
        "age = 25\n",
        "completed_assignments = 8\n",
        "percentage = 85.5\n",
        "\n",
        "# 3. Boolean variables\n",
        "course_completed = False\n",
        "attending_classes = True\n",
        "\n",
        "# 4. Datetime variables\n",
        "current_datetime = datetime(2026, 10, 17)\n",
        "course_start_date = datetime(2026, 9, 1)\n",
        "\n",
        "# 5. Print all variables and their datatypes\n",
        "print(\"Student Name:\", student_name)\n",
        "print(\"Datatype:\", type(student_name))\n",
        "\n",
        "print(\"Course Name:\", course_name)\n",
        "print(\"Datatype:\", type(course_name))\n",
        "\n",
        "print(\"City:\", city)\n",
        "print(\"Datatype:\", type(city))\n",
        "\n",
        "print(\"Age:\", age)\n",
        "print(\"Datatype:\", type(age))\n",
        "\n",
        "print(\"Completed Assignments:\", completed_assignments)\n",
        "print(\"Datatype:\", type(completed_assignments))\n",
        "\n",
        "print(\"Percentage:\", percentage)\n",
        "print(\"Datatype:\", type(percentage))\n",
        "\n",
        "print(\"Course Completed:\", course_completed)\n",
        "print(\"Datatype:\", type(course_completed))\n",
        "\n",
        "print(\"Attending Classes:\", attending_classes)\n",
        "print(\"Datatype:\", type(attending_classes))\n",
        "\n",
        "print(\"Current Date and Time:\", current_datetime)\n",
        "print(\"Datatype:\", type(current_datetime))\n",
        "\n",
        "print(\"Course Start Date:\", course_start_date)\n",
        "print(\"Datatype:\", type(course_start_date))\n",
        "\n",
        "# 6. Add 1 to age\n",
        "print(\"Age after adding 1:\", age + 1)\n",
        "\n",
        "# 7. Check course completion\n",
        "print(\"Has the student completed the course?\", course_completed)\n",
        "\n",
        "# 8. Display current date and time\n",
        "print(\"Today's Date and Time:\", datetime.now())\n",
